# Copy to secrets.yaml (never commit secrets.yaml — it is gitignored).
#
# lilygoT-Display-QuadSensor.yaml uses !secret for Wi‑Fi. For local compile,
# copy this file to secrets.yaml and set real values. CI uses this file as-is
# (dummy SSID/password) so GitHub builds stay zero-setup.

wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# Fallback AP when Wi‑Fi fails (match what you set under wifi: ap:)
refrigerator_quad_temp_display_ap_password: "change-me-ap"

# ESPHome → Settings → encryption key (optional hardening)
refrigerator_quad_temp_display_api_encryption_key: "REPLACE_WITH_YOUR_BASE64_KEY"

# OTA password (optional hardening)
refrigerator_quad_temp_display_ota_password: "change-me-ota"
