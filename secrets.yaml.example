# Copy to secrets.yaml (never commit secrets.yaml — it is gitignored).
#
# lilygoT-Display-QuadSensor.yaml uses !secret for Wi‑Fi. For local compile,
# copy this file to secrets.yaml and set real values. CI / Pages factory builds
# use this file as-is (dummy SSID/password); end users set Wi‑Fi via Improv or
# the Fallback_AP captive portal.

wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# Optional hardening if you add matching !secret references in your fork's YAML
# (public core keeps API/OTA open for prebuilt flashing).
tdisplay_quad_sensor_ap_password: "change-me-ap"
tdisplay_quad_sensor_api_encryption_key: "REPLACE_WITH_YOUR_BASE64_KEY"
tdisplay_quad_sensor_ota_password: "change-me-ota"
